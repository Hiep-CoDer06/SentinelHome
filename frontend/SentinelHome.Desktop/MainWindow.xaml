<Window x:Class="SentinelHome.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SentinelHome · Security Operations Console" Height="930" Width="1540" MinHeight="760" MinWidth="1180"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{DynamicResource BodyFont}" TextOptions.TextFormattingMode="Display">
    <Grid Loaded="Dashboard_OnLoaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="258"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Persistent navigation -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentBrush}" Margin="0,0,11,0">
                        <TextBlock Text="S" Foreground="{DynamicResource AccentOnBrush}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SENTINELHOME" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="SECURITY OPERATIONS" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="9" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="KHÔNG GIAN LÀM VIỆC" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,10"/>
                <StackPanel Grid.Row="3" VerticalAlignment="Top">
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" AutomationProperties.Name="Mở tổng quan">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Tổng quan" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Lịch sử" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" AutomationProperties.Name="Mở lịch sử sự kiện">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Lịch sử"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
                        </Button.Style>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Lịch sử sự kiện" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Cấu hình" HorizontalContentAlignment="Stretch" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Mở cấu hình hệ thống">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Cấu hình"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
                        </Button.Style>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Cấu hình hệ thống" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <!-- Realtime connection status -->
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10" Effect="{x:Null}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid>
                                <Ellipse Width="10" Height="10" Fill="{Binding ApiStatusBrush}" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCheckingConnection}" Value="True"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Kênh cảnh báo realtime" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="9" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ApiStatusText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10" Effect="{x:Null}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Center"><TextBlock Text="A" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding SignedInUsername}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding SignedInRole}" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10"/></StackPanel>
                        </Grid>
                    </Border>
                    <Button Command="{Binding LogoutCommand}" HorizontalContentAlignment="Left" Padding="10,8" AutomationProperties.Name="Đăng xuất"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,11,0"/><TextBlock Text="Đăng xuất"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- Command bar -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SidebarBrush}">
                <Grid Margin="32,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding CurrentPage}" FontFamily="{DynamicResource DisplayFont}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding LastSyncedText}" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="16" Padding="12,7" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="LIVE · CAMERA SÂN SAU" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></Border>
                        <Button Style="{StaticResource OutlineButtonStyle}" Command="{Binding RefreshApiStatusCommand}" AutomationProperties.Name="Làm mới dữ liệu"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0"/><TextBlock Text="Làm mới"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="32,26,32,32">
                <Grid>
                    <!-- DASHBOARD -->
                    <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Dashboard}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="310"/><RowDefinition Height="16"/><RowDefinition Height="106"/><RowDefinition Height="16"/><RowDefinition Height="250"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Trung tâm giám sát" FontFamily="{DynamicResource DisplayFont}" FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock Text="Theo dõi nguồn video, phát hiện AI và các sự kiện cần phản hồi." Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.62*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.98*"/></Grid.ColumnDefinitions>
                            <!-- Video-demo panel -->
                            <Border Style="{StaticResource CardStyle}" Padding="1" ClipToBounds="True">
                                <Grid>
                                    <Viewbox Stretch="Fill" Margin="1">
                                        <Canvas x:Name="LiveFrameCanvas" Width="920" Height="420" Background="{DynamicResource LiveFeedBrush}">
                                            <!-- stylized, asset-free video placeholder; API can replace this layer with a MediaElement -->
                                            <Rectangle Width="920" Height="162" Fill="#163A5A"/>
                                            <Rectangle Canvas.Top="162" Width="920" Height="258" Fill="#112B36"/>
                                            <Ellipse Canvas.Left="-85" Canvas.Top="62" Width="450" Height="300" Fill="#173D4B" Opacity="0.9"/>
                                            <Ellipse Canvas.Left="665" Canvas.Top="10" Width="330" Height="330" Fill="#1D4554" Opacity="0.85"/>
                                            <Path Data="M0,280 C140,225 220,300 330,260 S520,220 650,275 S800,290 920,230 L920,420 L0,420Z" Fill="#0A2029"/>
                                            <Path Data="M0,330 C120,280 255,353 370,315 S580,275 730,335 S840,350 920,315 L920,420 L0,420Z" Fill="#071A23"/>
                                            <Rectangle Canvas.Left="716" Canvas.Top="80" Width="156" Height="200" Fill="#122E38" Stroke="#40617A" StrokeThickness="3"/>
                                            <Rectangle Canvas.Left="745" Canvas.Top="110" Width="48" Height="58" Fill="#F5BD61" Opacity="0.75"/>
                                            <Rectangle Canvas.Left="806" Canvas.Top="110" Width="40" Height="58" Fill="#F5BD61" Opacity="0.6"/>
                                            <Path Data="M430,420 L590,252 L776,420Z" Fill="#0D2630"/>
                                            <Ellipse Canvas.Left="79" Canvas.Top="82" Width="115" Height="235" Fill="#163E3E"/>
                                            <Ellipse Canvas.Left="172" Canvas.Top="108" Width="142" Height="210" Fill="#174444"/>
                                            <TextBlock Canvas.Left="18" Canvas.Top="15" Text="&#xE714;  CAMERA SÂN SAU" FontFamily="Segoe Fluent Icons" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                                            <Border Canvas.Left="784" Canvas.Top="13" Background="#0B1728" CornerRadius="12" Padding="10,5"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/><TextBlock Text="TRỰC TIẾP" Foreground="White" FontSize="10" FontWeight="Bold"/></StackPanel></Border>
                                            <!-- Bounding boxes: nhận DetectionOverlay dạng normalized (0..1), quy đổi sang pixel của khung 920x420 để luôn khớp Viewbox dù cửa sổ đổi kích thước -->
                                            <ItemsControl ItemsSource="{Binding LiveOverlays}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding NormalizedLeft, Converter={StaticResource NormalizedToPixelConverter}, ConverterParameter=920}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding NormalizedTop, Converter={StaticResource NormalizedToPixelConverter}, ConverterParameter=420}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Canvas>
                                                            <Border Width="{Binding NormalizedWidth, Converter={StaticResource NormalizedToPixelConverter}, ConverterParameter=920}"
                                                                    Height="{Binding NormalizedHeight, Converter={StaticResource NormalizedToPixelConverter}, ConverterParameter=420}"
                                                                    BorderThickness="3" CornerRadius="3"
                                                                    BorderBrush="{Binding Severity, Converter={StaticResource ToneBrushConverter}}"/>
                                                            <Border Canvas.Top="-31" CornerRadius="3" Padding="8,4" Background="{Binding Severity, Converter={StaticResource ToneBrushConverter}}">
                                                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="Bold"/><TextBlock Text=" · " Foreground="White" FontSize="11"/><TextBlock Text="{Binding Confidence}" Foreground="White" FontSize="11" FontWeight="SemiBold"/></StackPanel>
                                                            </Border>
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Canvas.Left="18" Canvas.Top="380" Background="#A9071424" CornerRadius="7" Padding="9,5"><TextBlock Text="Nguồn demo · sẵn sàng thay bằng video database" Foreground="White" FontSize="10"/></Border>
                                            <Border Canvas.Left="790" Canvas.Top="380" Background="#B5071424" CornerRadius="7" Padding="9,5"><TextBlock Text="1080p · 25 FPS" Foreground="White" FontFamily="{DynamicResource DataFont}" FontSize="10"/></Border>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <!-- Alert queue -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="96"/></Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource DangerBrush}" FontSize="17" Margin="0,0,8,0"/><TextBlock Text="Cảnh báo đang mở" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource OutlineButtonStyle}" Command="{Binding SimulateNewAlertCommand}" Padding="9,5" Margin="0,0,8,0" FontSize="10" AutomationProperties.Name="Mô phỏng cảnh báo mới đến qua realtime"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,5,0"/><TextBlock Text="Mô phỏng"/></StackPanel></Button>
                                            <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding UnreadAlertCount}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="11"/></Border>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <ItemsControl ItemsSource="{Binding ActiveAlerts}" Visibility="{Binding HasActiveAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="9" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,7" Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding SeverityTone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=Soft}" CornerRadius="6"><TextBlock Text="{Binding Species, Converter={StaticResource SpeciesIconConverter}}" FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding SeverityTone, Converter={StaticResource ToneBrushConverter}}"/></Border>
                                                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding Species}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Camera}" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="9" Margin="0,2,0,0"/></StackPanel>
                                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right"><TextBlock Text="{Binding Confidence}" FontFamily="{DynamicResource DataFont}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="{Binding CapturedAt}" Foreground="{DynamicResource SubtleForegroundBrush}" FontFamily="{DynamicResource DataFont}" FontSize="9" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Visibility="{Binding HasActiveAlerts, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasActiveAlerts}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Không có cảnh báo đang mở" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="4" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding SelectedAlertTitle}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding SelectedAlertMetadata}" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="9" Margin="0,2,0,0"/></StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource OutlineButtonStyle}" Command="{Binding ViewEventDetailCommand}" CommandParameter="{Binding SelectedAlert}" Padding="9,6" FontSize="10" Margin="0,0,6,0" AutomationProperties.Name="Xem chi tiết cảnh báo đã chọn"><TextBlock Text="Chi tiết"/></Button>
                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AcknowledgeAlertCommand}" CommandParameter="{Binding SelectedAlert}" Padding="10,6" FontSize="10" AutomationProperties.Name="Đánh dấu cảnh báo đã xử lý"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Margin="0,0,5,0"/><TextBlock Text="Xử lý"/></StackPanel></Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Metrics -->
                        <ItemsControl Grid.Row="4" ItemsSource="{Binding Metrics}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,12,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{Binding Tone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=Soft}" VerticalAlignment="Top"><TextBlock Text="{Binding Tone, Converter={StaticResource ToneIconConverter}}" FontFamily="Segoe Fluent Icons" Foreground="{Binding Tone, Converter={StaticResource ToneBrushConverter}}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="10"/><TextBlock Text="{Binding Value}" FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold" FontSize="24" Margin="0,1,0,0"/><TextBlock Text="{Binding Detail}" Foreground="{Binding Tone, Converter={StaticResource ToneBrushConverter}}" FontSize="9"/></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Trend and activity -->
                        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.18*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="Biểu đồ phát hiện · 24 giờ" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="12 sự kiện" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" Margin="9,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,4,5,0"/><TextBlock Text="Phát hiện" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="10"/></StackPanel></Grid>
                                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"/><Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"/><Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"/><Canvas><Polyline Points="0,140 42,129 88,137 132,84 176,111 223,47 270,95 316,26 362,77 410,59 454,89 500,42" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" StrokeLineJoin="Round"/><Ellipse Canvas.Left="311" Canvas.Top="21" Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="3"/></Canvas><StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Stretch"><TextBlock Text="00:00" Foreground="{DynamicResource SubtleForegroundBrush}" FontFamily="{DynamicResource DataFont}" FontSize="9"/><TextBlock Text="06:00" Foreground="{DynamicResource SubtleForegroundBrush}" FontFamily="{DynamicResource DataFont}" FontSize="9" Margin="76,0,0,0"/><TextBlock Text="12:00" Foreground="{DynamicResource SubtleForegroundBrush}" FontFamily="{DynamicResource DataFont}" FontSize="9" Margin="76,0,0,0"/><TextBlock Text="18:00" Foreground="{DynamicResource SubtleForegroundBrush}" FontFamily="{DynamicResource DataFont}" FontSize="9" Margin="76,0,0,0"/></StackPanel></Grid>
                            </Grid></Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="Hoạt động gần đây" FontSize="15" FontWeight="SemiBold"/><Button Style="{StaticResource GhostButtonStyle}" Content="Xem tất cả" Command="{Binding NavigateCommand}" CommandParameter="Lịch sử" HorizontalAlignment="Right" FontSize="10" AutomationProperties.Name="Xem tất cả hoạt động gần đây"/></Grid>
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding RecentDetections}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{DynamicResource SubtleForegroundBrush}" FontFamily="{DynamicResource DataFont}" FontSize="9" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding Species, Converter={StaticResource SpeciesIconConverter}}" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource InfoBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding Species}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Camera}" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="9"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="{Binding Confidence}" Foreground="{DynamicResource MutedForegroundBrush}" FontFamily="{DynamicResource DataFont}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="9" VerticalAlignment="Center" TextAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Grid></Border>
                        </Grid>
                    </Grid>

                    <!-- HISTORY -->
                    <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Lịch sử}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Lịch sử sự kiện" FontFamily="{DynamicResource DisplayFont}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Tìm kiếm, phân loại và kiểm tra toàn bộ phát hiện từ các nguồn video." Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,5,0,0"/></StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" AutomationProperties.Name="Tìm kiếm lịch sử" ToolTip="Tìm theo đối tượng hoặc camera"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Tất cả" Command="{Binding FilterHistoryCommand}" CommandParameter="Tất cả" Padding="12,7" Margin="0,0,7,0" AutomationProperties.Name="Lọc tất cả sự kiện">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding HistoryFilter}" Value="Tất cả"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="Chưa xử lý" Command="{Binding FilterHistoryCommand}" CommandParameter="Chưa xử lý" Padding="12,7" Margin="0,0,7,0" AutomationProperties.Name="Lọc sự kiện chưa xử lý">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding HistoryFilter}" Value="Chưa xử lý"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="Đã xử lý" Command="{Binding FilterHistoryCommand}" CommandParameter="Đã xử lý" Padding="12,7" AutomationProperties.Name="Lọc sự kiện đã xử lý">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding HistoryFilter}" Value="Đã xử lý"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding HistoryFilter}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/></Grid></Border>
                        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0" MinHeight="350"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="14,14,0,0" Padding="16,0"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="THỜI GIAN" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="ĐỐI TƯỢNG / CAMERA" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="ĐỘ TIN CẬY" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="MỨC ĐỘ" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="TRẠNG THÁI" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" FontWeight="SemiBold" TextAlignment="Right"/></Grid></Border>
                            <Grid Grid.Row="1">
                                <ScrollViewer Visibility="{Binding HasHistoryResults, Converter={StaticResource BooleanToVisibilityConverter}}"><ItemsControl ItemsSource="{Binding HistoryDetections}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Time}" FontFamily="{DynamicResource DataFont}" FontSize="11"/><TextBlock Text="{Binding Date}" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="9" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,9,0"><TextBlock Text="{Binding Species, Converter={StaticResource SpeciesIconConverter}}" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/></Border><StackPanel><TextBlock Text="{Binding Species}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Camera}" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="{Binding Confidence}" FontFamily="{DynamicResource DataFont}" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/><Border Grid.Column="3" Background="{Binding Severity, Converter={StaticResource ToneBrushConverter}, ConverterParameter=Soft}" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Severity}" Foreground="{Binding Severity, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/></Border><TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontSize="11" TextAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasHistoryResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{DynamicResource SubtleForegroundBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Không tìm thấy sự kiện phù hợp bộ lọc" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid></Border>
                    </Grid>

                    <!-- SETTINGS -->
                    <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Cấu hình}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Cấu hình hệ thống" FontFamily="{DynamicResource DisplayFont}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Điều chỉnh nguồn video demo và quy tắc tạo cảnh báo cho phiên chạy hiện tại." Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,5,0,0"/></StackPanel>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Padding="20"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource InfoBrush}" FontSize="18" Margin="0,0,9,0"/><TextBlock Text="Nguồn video demo" FontSize="16" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Phát một tệp video đã lưu như luồng trực tiếp. Khi có API, đường dẫn này sẽ do backend cấp." Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock Text="Camera sân sau · online" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="VideoDemo.mp4 · 1080p · vòng lặp" Foreground="{DynamicResource SubtleForegroundBrush}" FontFamily="{DynamicResource DataFont}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Grid></Border><CheckBox IsChecked="{Binding IsDemoLoopEnabled}" Content="Tự lặp lại video khi phát hết" Margin="0,16,0,0" AutomationProperties.Name="Tự lặp lại video khi phát hết"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource WarningBrush}" FontSize="18" Margin="0,0,9,0"/><TextBlock Text="Quy tắc cảnh báo" FontSize="16" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Ngưỡng độ tin cậy tối thiểu" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,16,0,0"/><Grid Margin="0,7,0,0"><Slider Minimum="0.5" Maximum="0.99" Value="{Binding MinimumConfidence}" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Ngưỡng độ tin cậy tối thiểu để tạo cảnh báo"/><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="{Binding MinimumConfidenceText}" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource DataFont}" FontWeight="SemiBold" FontSize="11"/></Border></Grid><TextBlock Text="Chỉ tạo cảnh báo khi AI có độ tin cậy từ mức này trở lên." Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" Margin="0,7,0,0"/><CheckBox IsChecked="{Binding IsSoundEnabled}" Content="Phát âm thanh khi có cảnh báo nghiêm trọng" Margin="0,16,0,0" AutomationProperties.Name="Phát âm thanh khi có cảnh báo nghiêm trọng"/></StackPanel></Border>
                        </Grid>
                        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SettingsSavedText}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"/><TextBlock Text="Trong chế độ demo, cấu hình chỉ áp dụng cục bộ. Backend thật sẽ lưu vào AlertSettings." Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveSettingsCommand}" Padding="17,9" AutomationProperties.Name="Lưu cấu hình hệ thống"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0"/><TextBlock Text="Lưu cấu hình"/></StackPanel></Button></Grid></Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
