<Window x:Class="SentinelHome.Desktop.Views.AlertPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cảnh báo mới" Height="150" Width="360" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Effect="{DynamicResource PopupShadowEffect}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{Binding Alert.SeverityTone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=Soft}" CornerRadius="9" Width="34" Height="34" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Alert.Species, Converter={StaticResource SpeciesIconConverter}}" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{Binding Alert.SeverityTone, Converter={StaticResource ToneBrushConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CẢNH BÁO SỰ KIỆN MỚI" Foreground="{DynamicResource DangerBrush}" FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Alert.Species}" FontWeight="SemiBold" FontSize="14"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2">
                <TextBlock Text="{Binding Alert.Camera}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"/>
                <TextBlock Text="{Binding Alert.OtherObjectsSummary}" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource OutlineButtonStyle}" Command="{Binding DismissCommand}" Padding="0,8" AutomationProperties.Name="Đã xem cảnh báo"><TextBlock Text="Đã xem"/></Button>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ViewDetailCommand}" Padding="0,8" AutomationProperties.Name="Xem chi tiết cảnh báo mới"><TextBlock Text="Xem chi tiết"/></Button>
            </Grid>
        </Grid>
    </Border>
</Window>
